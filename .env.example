# Copy to .env and edit. All settings optional; defaults in src/config.py.

# lightweight = asyncio bus + JSONL | full = Redpanda + OpenSearch
CYBERDEF_MODE=lightweight

CYBERDEF_KAFKA_BROKERS=localhost:19092
CYBERDEF_OPENSEARCH_HOST=http://localhost:9200

CYBERDEF_SQLITE_DB_PATH=data/db/cyberdefense.db
CYBERDEF_TELEMETRY_OUTPUT_DIR=data/telemetry
CYBERDEF_PCAP_OUTPUT_DIR=data/pcaps
CYBERDEF_SCENARIO_DIR=data/scenarios
CYBERDEF_MODEL_DIR=data/models
CYBERDEF_DATASET_DIR=data/datasets
CYBERDEF_OUTPUT_DIR=data/output

# Same seed reproduces a simulation exactly
CYBERDEF_MASTER_SEED=42

CYBERDEF_API_HOST=0.0.0.0
CYBERDEF_API_PORT=8000

CYBERDEF_BATCH_SIZE=1000
CYBERDEF_FLUSH_INTERVAL_SECONDS=2.0
CYBERDEF_LOG_LEVEL=INFO

# Detection engine
CYBERDEF_DETECTION_WINDOW_SECONDS=300
CYBERDEF_DETECTION_BASELINE_WINDOW_SECONDS=3600
CYBERDEF_DETECTION_ALERT_THRESHOLD=0.40
# Score fusion weights must sum to 1.0
CYBERDEF_DETECTION_WEIGHT_RULE=0.35
CYBERDEF_DETECTION_WEIGHT_ANOMALY=0.25
CYBERDEF_DETECTION_WEIGHT_CLASSIFIER=0.25
CYBERDEF_DETECTION_WEIGHT_BEHAVIOUR=0.15

# Alerts further apart than this are never merged into one incident
CYBERDEF_CORRELATION_WINDOW_SECONDS=1800
